# ScholarPal Environment Configuration Example

# --- Application ---
ENVIRONMENT=development
PROJECT_NAME="ScholarPal API"
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-at-least-32-bytes-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scholarpal

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- AI & Verification Providers ---
# LLM API (for structured data extraction only - never used for eligibility)
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gemini-1.5-pro

# Jev by TypeSafe AI (Choice primitive for evidence checks - never auto-publishes)
JEV_API_KEY=your-typesafe-ai-jev-key-here
